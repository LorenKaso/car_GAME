# Generate real local values with: python infrastructure/setup_local.py
APP_ENV=development
DATABASE_URL=postgresql+psycopg://racing_app:REPLACE@localhost:5432/racing
MIGRATION_DATABASE_URL=postgresql+psycopg://racing_owner:REPLACE@localhost:5432/racing
OUTBOX_KEY=REPLACE_WITH_FERNET_KEY
RATE_LIMIT_KEY=REPLACE_WITH_RANDOM_32_BYTES_OR_MORE
PUBLIC_APP_URL=http://localhost:8000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM=no-reply@example.test
