          "id",
          "username",
          "display_name",
          "avatar_reference",
          "country",
          "coins",
          "xp",
          "level",
          "created_at",
          "updated_at"
        ],
        "title": "ProfileOutput"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 40,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Refresh Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
